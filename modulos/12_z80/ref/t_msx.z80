; Z80 + msx_mem + SDRAM integration test. ROM in slot 0 (not mapped). Result: OUT (E0h),A  01=PASS  EE=FAIL (E1h = test number)
	org 0
	di
	ld sp,0FF00h
	ld a,0FCh		; pages 1-3 -> slot 3 (mapper); page 0 -> slot 0 (ROM)
	out (0A8h),a
	; --- T1: fills 4000 (seg 2), 8000 (seg 1), C000 (seg 0) with distinct patterns
	ld hl,4000h
	ld (hl),11h
	inc hl
	ld (hl),12h
	ld hl,8000h
	ld (hl),21h
	ld hl,0C000h
	ld (hl),31h
	ld a,(4000h)
	cp 11h
	jp nz,fail1
	ld a,(8000h)
	cp 21h
	jp nz,fail1
	ld a,(0C000h)
	cp 31h
	jp nz,fail1
	; --- T2: remap page 1 to segment 5; write; go back to segment 2 and check
	ld a,5
	out (0FDh),a
	ld a,(4000h)		; segment 5 still zeroed
	or a
	jp nz,fail2
	ld a,55h
	ld (4000h),a
	ld a,2
	out (0FDh),a
	ld a,(4000h)
	cp 11h
	jp nz,fail2
	ld a,5
	out (0FDh),a
	ld a,(4000h)
	cp 55h
	jp nz,fail2
	; --- T3: page 3 points to the same segment as page 1 (alias); port read returns the value
	ld a,5
	out (0FFh),a
	ld a,(0C000h)
	cp 55h
	jp nz,fail3
	in a,(0FFh)
	cp 0C5h			; unused bits (6 segment bits) read as 1
	jp nz,fail3
	; --- T4: block copy with LDIR between segments (page 1 seg 5 -> page 2 seg 1)
	ld hl,4000h
	ld de,8100h
	ld bc,100h
	ld a,0
	ld b,0
fill:	ld (hl),a
	inc hl
	inc a
	djnz fill
	ld hl,4000h
	ld de,8100h
	ld bc,100h
	ldir
	ld hl,8100h
	ld b,0
	ld c,0
chk:	ld a,(hl)
	cp c
	jp nz,fail4
	inc hl
	inc c
	djnz chk
	; --- T5: MegaRAM ASCII8 no slot 2 (paginas 1 e 2). A8 = pagina3 slot3, pagina2 slot2, pagina1 slot2, pagina0 slot0
	ld a,0E8h
	out (0A8h),a
	ld sp,0FF00h
	in a,(8Eh)		; turns on MegaRAM write mode
	ld a,3
	ld (6000h),a		; bank 3 in the 4000 window
	ld a,0A3h
	ld (4000h),a
	ld a,4
	ld (6000h),a		; banco 4
	ld a,0A4h
	ld (4000h),a
	out (8Eh),a		; back to ASCII8 mode (write only switches bank)
	ld a,3
	ld (6000h),a
	ld a,(4000h)
	cp 0A3h
	jp nz,fail5
	ld a,4
	ld (6000h),a
	ld a,(4000h)
	cp 0A4h
	jp nz,fail5
	ld a,77h
	ld (4000h),a		; ROM mode: write ignored
	ld a,(4000h)
	cp 0A4h
	jp nz,fail5
	ld a,3
	ld (6000h),a
	ld a,(4000h)
	cp 0A3h
	jp nz,fail5
	; --- T6: window 2 (8000) with independent bank
	ld a,4
	ld (7000h),a		; bank of the 8000 window
	ld a,(8000h)
	cp 0A4h
	jp nz,fail6
	ld a,1
	out (0E0h),a
	halt
fail1:	ld a,1
	jr fail
fail2:	ld a,2
	jr fail
fail3:	ld a,3
	jr fail
fail4:	ld a,4
	jr fail
fail5:	ld a,5
	jr fail
fail6:	ld a,6
fail:	out (0E1h),a
	ld a,0EEh
	out (0E0h),a
	halt
