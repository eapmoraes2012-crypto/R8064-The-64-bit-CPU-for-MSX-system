; teste de integracao Z80 + msx_mem + SDRAM. ROM no slot 0 (nao mapeado). Resultado: OUT (E0h),A  01=PASS  EE=FAIL (E1h = numero do teste)
	org 0
	di
	ld sp,0FF00h
	ld a,0FCh		; paginas 1-3 -> slot 3 (mapper); pagina 0 -> slot 0 (ROM)
	out (0A8h),a
	; --- T1: preenche 4000 (seg 2), 8000 (seg 1), C000 (seg 0) com padroes distintos
	ld hl,4000h
	ld (hl),11h
	inc hl
	ld (hl),12h
	ld hl,8000h
	ld (hl),21h
	ld hl,0C000h
	ld (hl),31h
	ld a,(4000h)
	cp 11h
	jp nz,fail1
	ld a,(8000h)
	cp 21h
	jp nz,fail1
	ld a,(0C000h)
	cp 31h
	jp nz,fail1
	; --- T2: remapeia pagina 1 para segmento 5; escreve; volta ao segmento 2 e confere
	ld a,5
	out (0FDh),a
	ld a,(4000h)		; segmento 5 ainda zerado
	or a
	jp nz,fail2
	ld a,55h
	ld (4000h),a
	ld a,2
	out (0FDh),a
	ld a,(4000h)
	cp 11h
	jp nz,fail2
	ld a,5
	out (0FDh),a
	ld a,(4000h)
	cp 55h
	jp nz,fail2
	; --- T3: pagina 3 aponta o mesmo segmento da pagina 1 (alias); leitura de porta devolve o valor
	ld a,5
	out (0FFh),a
	ld a,(0C000h)
	cp 55h
	jp nz,fail3
	in a,(0FFh)
	cp 0C5h			; bits nao usados (6 bits de segmento) leem 1
	jp nz,fail3
	; --- T4: copia de bloco com LDIR entre segmentos (pagina 1 seg 5 -> pagina 2 seg 1)
	ld hl,4000h
	ld de,8100h
	ld bc,100h
	ld a,0
	ld b,0
fill:	ld (hl),a
	inc hl
	inc a
	djnz fill
	ld hl,4000h
	ld de,8100h
	ld bc,100h
	ldir
	ld hl,8100h
	ld b,0
	ld c,0
chk:	ld a,(hl)
	cp c
	jp nz,fail4
	inc hl
	inc c
	djnz chk
	; --- T5: MegaRAM ASCII8 no slot 2 (paginas 1 e 2). A8 = pagina3 slot3, pagina2 slot2, pagina1 slot2, pagina0 slot0
	ld a,0E8h
	out (0A8h),a
	ld sp,0FF00h
	in a,(8Eh)		; liga modo de escrita da MegaRAM
	ld a,3
	ld (6000h),a		; banco 3 na janela 4000
	ld a,0A3h
	ld (4000h),a
	ld a,4
	ld (6000h),a		; banco 4
	ld a,0A4h
	ld (4000h),a
	out (8Eh),a		; volta ao modo ASCII8 (escrita so troca banco)
	ld a,3
	ld (6000h),a
	ld a,(4000h)
	cp 0A3h
	jp nz,fail5
	ld a,4
	ld (6000h),a
	ld a,(4000h)
	cp 0A4h
	jp nz,fail5
	ld a,77h
	ld (4000h),a		; modo ROM: escrita ignorada
	ld a,(4000h)
	cp 0A4h
	jp nz,fail5
	ld a,3
	ld (6000h),a
	ld a,(4000h)
	cp 0A3h
	jp nz,fail5
	; --- T6: janela 2 (8000) com banco independente
	ld a,4
	ld (7000h),a		; banco da janela 8000
	ld a,(8000h)
	cp 0A4h
	jp nz,fail6
	ld a,1
	out (0E0h),a
	halt
fail1:	ld a,1
	jr fail
fail2:	ld a,2
	jr fail
fail3:	ld a,3
	jr fail
fail4:	ld a,4
	jr fail
fail5:	ld a,5
	jr fail
fail6:	ld a,6
fail:	out (0E1h),a
	ld a,0EEh
	out (0E0h),a
	halt
