IO_PORT "IO_sdram_dq[18]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "IO_sdram_dq[19]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "IO_sdram_dq[20]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "IO_sdram_dq[21]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
