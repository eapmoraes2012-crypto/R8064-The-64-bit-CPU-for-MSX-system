// Tang Nano 20K - r8064_board_top top. Pins checked against the pin report of the VDP cartridge (GW2AR-LV18QN88C8). Embedded SDRAM: no IO_LOC (nextpnr places it).
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "clk_ext" 80;
IO_PORT "clk_ext" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "dbg_init" 84;
IO_LOC "dbg_lock" 83;
IO_LOC "dbg_sig" 82;
IO_LOC "dbg_hb" 81;
IO_PORT "dbg_init" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_lock" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_sig" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_hb" IO_TYPE=LVCMOS33 DRIVE=8;
