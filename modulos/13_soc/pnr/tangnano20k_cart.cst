IO_PORT "slot_a[4]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[3]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[2]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[1]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[0]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_LOC "slot_d[7]" 73;
IO_LOC "slot_d[6]" 74;
IO_LOC "slot_d[5]" 75;
IO_LOC "slot_d[4]" 85;
IO_LOC "slot_d[3]" 77;
IO_LOC "slot_d[2]" 27;
IO_LOC "slot_d[1]" 28;
IO_LOC "slot_d[0]" 29;
IO_PORT "slot_d[7]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
