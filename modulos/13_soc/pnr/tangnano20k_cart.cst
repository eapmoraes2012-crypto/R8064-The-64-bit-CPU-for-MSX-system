// Tang Nano 20K na placa V9968_Cartridge (4a revisao): topo r8064_cart_top. Pinos conforme fpga/V9968_Cartridge_TangNano20K/src/tangnano20k_vdp_cartridge.cst
// (fatos de ligacao da placa: A0-A7 e D0-D7 por SN74LVC8T245, /IORQ /RD /WR /RESET so entrada, WAIT/INT/BUSDIR por MOSFET). SDRAM embutida: sem IO_LOC.
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "clk14m" 80;
IO_PORT "clk14m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "slot_reset_n" 86;
IO_LOC "slot_iorq_n" 18;
IO_LOC "slot_rd_n" 15;
IO_LOC "slot_wr_n" 16;
IO_PORT "slot_reset_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_iorq_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_rd_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_wr_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_LOC "slot_a[7]" 17;
IO_LOC "slot_a[6]" 49;
IO_LOC "slot_a[5]" 48;
IO_LOC "slot_a[4]" 41;
IO_LOC "slot_a[3]" 42;
IO_LOC "slot_a[2]" 76;
IO_LOC "slot_a[1]" 31;
IO_LOC "slot_a[0]" 30;
IO_PORT "slot_a[7]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[6]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[5]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[4]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[3]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[2]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[1]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_a[0]" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_LOC "slot_d[7]" 73;
IO_LOC "slot_d[6]" 74;
IO_LOC "slot_d[5]" 75;
IO_LOC "slot_d[4]" 85;
IO_LOC "slot_d[3]" 77;
IO_LOC "slot_d[2]" 27;
IO_LOC "slot_d[1]" 28;
IO_LOC "slot_d[0]" 29;
IO_PORT "slot_d[7]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[6]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[5]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[4]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[3]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[2]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[1]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[0]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_LOC "slot_data_dir" 19;
IO_LOC "slot_wait" 72;
IO_LOC "slot_intr" 71;
IO_LOC "oe_n" 20;
IO_PORT "slot_data_dir" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_wait" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_intr" IO_TYPE=LVTTL33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "oe_n" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
// observacao: pads da placa sem ligacao (IOB6A/IOB6B do modulo, pinos 25 e 26)
IO_LOC "dbg_sig" 25;
IO_LOC "dbg_hb" 26;
IO_PORT "dbg_sig" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_hb" IO_TYPE=LVCMOS33 DRIVE=8;
