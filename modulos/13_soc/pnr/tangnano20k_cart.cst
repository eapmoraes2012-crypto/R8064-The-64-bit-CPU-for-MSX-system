// Tang Nano 20K on the V9968_Cartridge board (4th revision): top r8064_cart_top. Pins as in fpga/V9968_Cartridge_TangNano20K/src/tangnano20k_vdp_cartridge.cst
// (board wiring facts: A0-A7 and D0-D7 through SN74LVC8T245, /IORQ /RD /WR /RESET input only, WAIT/INT/BUSDIR through MOSFET). Embedded SDRAM: no IO_LOC.
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "clk14m" 80;
IO_PORT "clk14m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "slot_reset_n" 86;
IO_LOC "slot_iorq_n" 18;
IO_LOC "slot_rd_n" 15;
IO_LOC "slot_wr_n" 16;
IO_PORT "slot_reset_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_iorq_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_rd_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_PORT "slot_wr_n" IO_TYPE=LVTTL33 PULL_MODE=UP;
IO_LOC "slot_a[7]" 17;
IO_LOC "slot_a[6]" 49;
IO_LOC "slot_a[5]" 48;
IO_LOC "slot_a[4]" 41;
IO_LOC "slot_a[3]" 42;
IO_LOC "slot_a[2]" 76;
IO_LOC "slot_a[1]" 31;
IO_LOC "slot_a[0]" 30;
