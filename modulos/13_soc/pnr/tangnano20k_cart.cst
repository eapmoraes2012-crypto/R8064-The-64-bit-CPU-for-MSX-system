IO_PORT "slot_d[1]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_d[0]" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_LOC "slot_data_dir" 19;
IO_LOC "slot_wait" 72;
IO_LOC "slot_intr" 71;
IO_LOC "oe_n" 20;
IO_PORT "slot_data_dir" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_wait" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
IO_PORT "slot_intr" IO_TYPE=LVTTL33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "oe_n" IO_TYPE=LVTTL33 PULL_MODE=UP DRIVE=8;
// observation: unconnected board pads (IOB6A/IOB6B of the module, pins 25 and 26)
IO_LOC "dbg_sig" 25;
IO_LOC "dbg_hb" 26;
IO_PORT "dbg_sig" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_hb" IO_TYPE=LVCMOS33 DRIVE=8;
// Embedded SDRAM: no IO_LOC (fixed GW2AR pads), but the I/O standard must be given: Gowin defaults unconstrained ports to LVCMOS18,
// which locks their bank at 1.8 V and conflicts with the 3.3 V pins of the same bank (error CT1136 on clk27, pin 4).
IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "O_sdram_cke" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
