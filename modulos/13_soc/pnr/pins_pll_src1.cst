// WARNING: pin 87 is only an example - change it to the physical pin where you connect the oscillator/MSX slot CLOCK.
IO_LOC "clk_in" 87;
IO_PORT "clk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "din" 88;
IO_PORT "din" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "dout" 15;
IO_PORT "dout" IO_TYPE=LVCMOS33 DRIVE=8;
